# Database (Neon Postgres)
# Get these from your Neon dashboard: https://console.neon.tech
# DATABASE_URL uses the pooled connection (-pooler suffix)
# DIRECT_URL uses the direct connection (for migrations)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[database]?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[database]?sslmode=require"

# Braintrust: authenticates the AI gateway used for the chatbot's model calls.
# No OPENAI_API_KEY is needed - provider credentials live in Braintrust settings.
# The gateway is used for model access only; no tracing is attached.
BRAINTRUST_API_KEY=sk-...
